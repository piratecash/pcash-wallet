<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <!--Final, top-level theme-->
    <style name="Theme.AppTheme.DayNight" parent="Theme.AppTheme"/>

    <style name="Theme.AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorAccent">@color/brand_default</item>
        <item name="android:windowBackground">@color/background_base</item>
        <item name="android:actionMenuTextAppearance">@style/Headline2</item>
        <item name="colorControlNormal">@color/icon_secondary</item>
        <item name="colorControlActivated">@color/brand_default</item>
        <item name="colorControlHighlight">#6E7899</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_back</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>

        <item name="TitleColor">@color/text_primary</item>
        <item name="RoundRippleColor">@color/light_grey</item>
        <item name="ColorWindowBackground">@color/background_base</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_base</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.AppTheme.DayNight</item>
    </style>

    <!-- Stealth splash for CalculatorEntryActivity. Uses the calculator launcher icon
         instead of the wallet logo so the launcher screen does not reveal that a crypto
         wallet is installed (visible mostly on slower devices where the splash lingers). -->
    <style name="Theme.App.Starting.Calculator" parent="Theme.App.Starting">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/launcher_calculator</item>
    </style>
</resources>
